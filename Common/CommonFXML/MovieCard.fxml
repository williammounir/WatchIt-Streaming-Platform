<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox fx:id="cardRoot"
      alignment="TOP_CENTER"
      spacing="6"
      prefWidth="150"
      prefHeight="240"
      style="-fx-background-color: #1e1e1e;
             -fx-background-radius: 10;
             -fx-border-radius: 10;
             -fx-border-color: #2a2a2a;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="UI.Common.CommonControllers.MovieCardController">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <ImageView fx:id="posterImage"
               fitWidth="130"
               fitHeight="170"
               preserveRatio="false"
               smooth="true"
               style="-fx-background-radius: 8;" />

    <Label fx:id="movieTitle"
           text="Movie Title"
           wrapText="true"
           maxWidth="130"
           style="-fx-text-fill: white;
                  -fx-font-size: 13px;
                  -fx-font-weight: bold;"
           alignment="CENTER"/>

    <HBox alignment="CENTER" spacing="8">

        <Label fx:id="ratingLabel"
               text="⭐ 8.5"
               style="-fx-text-fill: #f5c518;
                      -fx-font-size: 12px;"/>

        <Label fx:id="durationLabel"
               text="120m"
               style="-fx-text-fill: #bbbbbb;
                      -fx-font-size: 12px;"/>

    </HBox>

</VBox>
