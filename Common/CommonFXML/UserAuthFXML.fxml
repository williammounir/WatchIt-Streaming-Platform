<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" styleClass="root" stylesheets="@/Styles/admin-login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.Common.CommonControllers.User_Authentication_Controller">

    <ImageView fx:id="backgroundImageView" preserveRatio="false" smooth="true">
        <image>
            <Image url="@/Images/LoginBack.jpg" />
        </image>
    </ImageView>


    <StackPane maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: rgba(0,0,0,0.55);" />


    <VBox alignment="CENTER" spacing="35" styleClass="content-container" StackPane.alignment="CENTER">


        <ImageView fitHeight="90" preserveRatio="true">
            <image>
                <Image url="@/Images/logo2.jpg" />
            </image>
        </ImageView>


        <Label styleClass="subtitle-label" text="User Authentication" textFill="WHITE">
            <font>
                <Font size="26" />
            </font>
        </Label>
      <Button fx:id="loginBtn" mnemonicParsing="false" onAction="#UserLogin" prefHeight="48.0" prefWidth="150.0" styleClass="btn-signin" text="LOGIN" />
      <Button fx:id="signupBtn" mnemonicParsing="false" onAction="#UserSignUp" prefHeight="48.0" prefWidth="200.0" styleClass="btn-signin" text="SIGN UP" />
      <Button fx:id="renewBtn" mnemonicParsing="false" onAction="#UserRenewSubscription" prefHeight="48.0" prefWidth="300.0" styleClass="btn-signin" text="RENEW SUBSCRIPTION" />
      <Button fx:id="MainMenuBtn1" mnemonicParsing="false" onAction="#ReturnToMainMenu" prefHeight="48.0" prefWidth="400.0" styleClass="btn-signin" text="MAIN MENU" />

        <Label styleClass="restricted-notice" text="Choose an option to continue" textFill="#eb0909" />

    </VBox>

</StackPane>
