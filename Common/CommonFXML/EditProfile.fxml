<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="UI.Common.CommonControllers.EditProfileController">


    <ImageView fx:id="backgroundImageView" preserveRatio="false" smooth="true">
        <image>
            <Image url="@/Images/background2.jpg" />
        </image>
    </ImageView>

    <Pane style="-fx-background-color: rgba(0,0,0,0.65);"/>

    <VBox spacing="25"
          alignment="CENTER"
          maxWidth="450">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="Edit Profile"
               style="-fx-font-size: 32px;
                      -fx-text-fill: white;
                      -fx-font-weight: bold;" />

        <VBox spacing="15">

            <TextField fx:id="usernameField"
                       promptText="Username"
                       editable="false"
                       style="-fx-background-radius: 10;
                              -fx-padding: 10;" />

            <TextField fx:id="firstNameField"
                       promptText="First Name"
                       style="-fx-background-radius: 10;
                              -fx-padding: 10;" />

            <TextField fx:id="lastNameField"
                       promptText="Last Name"
                       style="-fx-background-radius: 10;
                              -fx-padding: 10;" />

            <TextField fx:id="emailField"
                       promptText="Email"
                       style="-fx-background-radius: 10;
                              -fx-padding: 10;" />

            <PasswordField fx:id="passwordField"
                           promptText="New Password (leave blank to keep current)"
                           style="-fx-background-radius: 10;
                                  -fx-padding: 10;" />

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm Password"
                           style="-fx-background-radius: 10;
                                  -fx-padding: 10;" />

            <Label fx:id="messageLabel"
                   style="-fx-text-fill: #ff6b6b;
                          -fx-font-size: 14px;" />

            <HBox spacing="20" alignment="CENTER">

                <Button fx:id="saveButton"
                        text="Save Changes"
                        style="-fx-background-color: #4CAF50;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;
                               -fx-padding: 8 25 8 25;" />

                <Button fx:id="cancelButton"
                        text="Cancel"
                        style="-fx-background-color: #e74c3c;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;
                               -fx-padding: 8 25 8 25;" />
            </HBox>

        </VBox>
    </VBox>

</StackPane>