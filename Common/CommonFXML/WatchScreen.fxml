<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.media.*?>
<?import javafx.scene.image.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="UI.Common.CommonControllers.WatchController"
           style="-fx-background-color: black;">


    <ImageView fx:id="backgroundImage"
               preserveRatio="false"
               opacity="0.25"
               StackPane.alignment="CENTER" />


    <BorderPane prefWidth="1200" prefHeight="800">


        <top>
            <HBox alignment="CENTER_LEFT"
                  spacing="15"
                  style="-fx-padding: 12 18; -fx-background-color: rgba(0,0,0,0.65);">

                <Button text="Finish"
                        onAction="#onFinish"
                        style="-fx-background-color: #e50914;
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;" />

                <Label fx:id="titleLabel"
                       style="-fx-text-fill: white;
                              -fx-font-size: 20px;
                              -fx-font-weight: bold;" />
            </HBox>
        </top>


        <center>
            <StackPane alignment="CENTER" style="-fx-padding: 20;">

                <StackPane alignment="CENTER"
                           style="-fx-background-color: black;
                                  -fx-background-radius: 12;
                                  -fx-padding: 10;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 40,0,0,0);">

                    <MediaView fx:id="mediaView"
                               preserveRatio="true"
                               StackPane.alignment="CENTER" />

                </StackPane>

            </StackPane>
        </center>


        <bottom>
            <VBox spacing="10"
                  alignment="CENTER"
                  style="-fx-padding: 12 18;
                         -fx-background-color: rgba(0,0,0,0.65);">


                <Slider fx:id="progressSlider" prefWidth="900"/>


                <HBox alignment="CENTER" spacing="18">

                    <Button text="⏪"
                            onAction="#onBackward"
                            styleClass="player-btn"/>

                    <Button text="▶"
                            onAction="#onPlay"
                            styleClass="player-btn"/>

                    <Button text="⏸"
                            onAction="#onPause"
                            styleClass="player-btn"/>

                    <Button text="⏹"
                            onAction="#onStop"
                            styleClass="player-btn"/>

                    <Button text="⏩"
                            onAction="#onForward"
                            styleClass="player-btn"/>

                    <Region prefWidth="40"/>

                    <Label text="Volume"
                           style="-fx-text-fill: white;"/>

                    <Slider fx:id="volumeSlider" prefWidth="160"/>

                </HBox>
            </VBox>
        </bottom>

    </BorderPane>

</StackPane>
