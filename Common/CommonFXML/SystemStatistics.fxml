<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="UI.Common.CommonControllers.SystemStatisticsController"
            stylesheets="@/Styles/admin-login.css">

    <center>

        <VBox spacing="30" alignment="TOP_CENTER">

            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <Label text="System Statistics"
                   style="-fx-font-size:28px; -fx-text-fill:white; -fx-font-weight:bold;" />

            <HBox spacing="30" alignment="CENTER">

                <VBox alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:#151c2e; -fx-background-radius:10; -fx-padding:20;">
                    <Label text="Total Users"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:14px;"/>
                    <Label fx:id="lblTotalUsers"
                           style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:#151c2e; -fx-background-radius:10; -fx-padding:20;">
                    <Label text="Total Movies"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:14px;"/>
                    <Label fx:id="lblTotalMovies"
                           style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:#151c2e; -fx-background-radius:10; -fx-padding:20;">
                    <Label text="Active Subscriptions"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:14px;"/>
                    <Label fx:id="lblActiveSubs"
                           style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>
                </VBox>

            </HBox>

            <HBox spacing="30" alignment="CENTER">

                <VBox alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:#151c2e; -fx-background-radius:10; -fx-padding:20;">
                    <Label text="Started This Month"
                           style="-fx-text-fill:#aaaaaa;"/>
                    <Label fx:id="lblStartedMonth"
                           style="-fx-text-fill:white; -fx-font-size:20px;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:#151c2e; -fx-background-radius:10; -fx-padding:20;">
                    <Label text="Ended This Month"
                           style="-fx-text-fill:#aaaaaa;"/>
                    <Label fx:id="lblEndedMonth"
                           style="-fx-text-fill:white; -fx-font-size:20px;"/>
                </VBox>

            </HBox>


            <VBox alignment="CENTER" spacing="10">

                <Label text="Movies Distribution by Genre"
                       style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;" />

                <PieChart fx:id="genrePieChart"
                          prefWidth="450"
                          prefHeight="350"/>

            </VBox>


            <HBox spacing="20" alignment="CENTER">

                <Button text="Refresh"
                        onAction="#onRefresh"
                        styleClass="btn-signin"/>

                <Button text="Back"
                        onAction="#onBack"
                        styleClass="btn-signin"/>


            </HBox>

        </VBox>

    </center>

</BorderPane>